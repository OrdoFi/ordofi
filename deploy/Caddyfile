# OrdoFi edge — automatic TLS via Caddy. Point DNS A records at the host.
# Usage: caddy run --config deploy/Caddyfile
#
# The apex is deliberately absent. ordofi.network and www.ordofi.network are
# the Framer marketing site and resolve to Framer's own hosts; claiming them
# here would either fail to get a certificate or take the marketing site down
# the moment DNS was pointed at this box. Everything OrdoFi actually runs lives
# on a subdomain.
#
# DNS needed, all A records at this host:
#   app.ordofi.network       explorer, docs, dashboard, /api/*
#   rpc.ordofi.network       the gateway
#   auction.ordofi.network   order-flow auction and searcher WebSocket

app.ordofi.network {
	reverse_proxy web:3000
	encode gzip
}

rpc.ordofi.network {
	# gateway enforces API keys + per-key rate limits itself.
	#
	# Two replicas (docker-compose.prod.yml), named so they can be static
	# upstreams: Caddy only runs active health checks against static upstreams,
	# and the health check is what makes a deploy invisible. A replica being
	# retired answers /health with 503 for a few seconds before its listener
	# closes, so it is out of rotation before anything could fail; one that is
	# gone fails to dial and the request is retried on the other. Caddy only
	# retries when nothing was sent upstream yet, so a transaction is never
	# submitted twice. deploy/rollout.sh drives the sequence.
	reverse_proxy gateway-a:8547 gateway-b:8547 {
		lb_policy least_conn
		lb_try_duration 4s
		lb_try_interval 250ms
		health_uri /health
		health_interval 2s
		health_timeout 1s
		fail_duration 5s
		transport http {
			# Warm connections into the replicas; a wallet's polling should
			# not pay a handshake per call.
			keepalive 2m
			keepalive_idle_conns_per_host 64
		}
	}
	# zstd first: every modern wallet and browser accepts it and it is cheaper
	# for the same ratio. JSON-RPC bodies are small, but block and log
	# responses are not.
	encode zstd gzip
}

auction.ordofi.network {
	# WebSocket (searcher feed) + HTTP (/submit, /stats) on the same host.
	reverse_proxy auction:8548
}
