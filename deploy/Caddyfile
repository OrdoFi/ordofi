# OrdoFi edge — automatic TLS via Caddy. Point DNS A records at the host.
# Usage: caddy run --config deploy/Caddyfile
#
# The apex is deliberately absent. ordofi.network and www.ordofi.network are
# the Framer marketing site and resolve to Framer's own hosts; claiming them
# here would either fail to get a certificate or take the marketing site down
# the moment DNS was pointed at this box. Everything OrdoFi actually runs lives
# on a subdomain.
#
# DNS needed, all A records at this host:
#   app.ordofi.network       explorer, docs, dashboard, /api/*
#   rpc.ordofi.network       the gateway
#   auction.ordofi.network   order-flow auction and searcher WebSocket
#   ordoliquidity.app        pools, stakes, positions (the `liquidity` service)
#   www.ordoliquidity.app    redirects to the apex

app.ordofi.network {
	reverse_proxy web:3000
	encode gzip
}

# The liquidity product on its own domain. Same code as app.ordofi.network,
# a separate process with the pools pages enabled; the root is the pools list.
# Until the A record points here, Caddy retries the certificate in the
# background and nothing else on this box is affected.
ordoliquidity.app {
	@root path /
	redir @root /pools 302
	# Only the liquidity product lives here: its three pages, the API they call,
	# and the static files they load. Trade, stealth, desk, docs, explorer and
	# the rest of the app stay on app.ordofi.network — anything else asked for
	# on this host is sent there, path intact.
	@liquidity path /pools /pools/* /stakes /positions /api/* /vendor/* /*.js /*.css /*.png /*.svg /*.ico /*.webmanifest /*.woff2
	handle @liquidity {
		reverse_proxy liquidity:3000
	}
	handle {
		redir https://app.ordofi.network{uri} 302
	}
	encode zstd gzip
}

www.ordoliquidity.app {
	redir https://ordoliquidity.app{uri} permanent
}

rpc.ordofi.network {
	# gateway enforces API keys + per-key rate limits itself.
	#
	# Cloudflare fronts this host. The gateway keys its anonymous limits on
	# Cf-Connecting-Ip when present (x-forwarded-for would name the edge, and
	# one edge carries many wallets), so that header must only ever come from
	# Cloudflare: strip it from any request whose peer is not in Cloudflare's
	# published ranges (cloudflare.com/ips-v4, /ips-v6), or a direct hit on the
	# origin could pick its own rate-limit key.
	@not_cloudflare not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	request_header @not_cloudflare -Cf-Connecting-Ip
	#
	# Two replicas (docker-compose.prod.yml), named so they can be static
	# upstreams: Caddy only runs active health checks against static upstreams,
	# and the health check is what makes a deploy invisible. A replica being
	# retired answers /health with 503 for a few seconds before its listener
	# closes, so it is out of rotation before anything could fail; one that is
	# gone fails to dial and the request is retried on the other. Caddy only
	# retries when nothing was sent upstream yet, so a transaction is never
	# submitted twice. deploy/rollout.sh drives the sequence.
	reverse_proxy gateway-a:8547 gateway-b:8547 {
		lb_policy least_conn
		lb_try_duration 4s
		lb_try_interval 250ms
		health_uri /health
		health_interval 2s
		health_timeout 1s
		# Two consecutive misses, not one. A replica busy enough to miss a 1s
		# health check is usually still answering requests, and ejecting it on a
		# single miss is how both ended up out of rotation at once — for three
		# hours one morning, Caddy answered "no upstreams available" 24,000
		# times while both gateways were up and serving. A deploy still drains
		# cleanly: a retiring replica answers 503 immediately and deliberately,
		# and health_status counts that as a miss the moment it appears.
		health_passes 1
		health_fails 2
		fail_duration 5s
		transport http {
			# Warm connections into the replicas; a wallet's polling should
			# not pay a handshake per call.
			keepalive 2m
			keepalive_idle_conns_per_host 64
		}
	}
	# zstd first: every modern wallet and browser accepts it and it is cheaper
	# for the same ratio. JSON-RPC bodies are small, but block and log
	# responses are not.
	encode zstd gzip
}

auction.ordofi.network {
	# WebSocket (searcher feed) + HTTP (/submit, /stats) on the same host.
	reverse_proxy auction:8548
}
