{
  "name": "ordofi",
  "private": true,
  "version": "0.1.0",
  "description": "OrdoFi \u2014 the execution layer for Robinhood Chain",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "watcher": "npm run start -w @ordofi/watcher",
    "report": "npm run report -w @ordofi/watcher",
    "trace": "npm run trace -w @ordofi/watcher",
    "gateway": "npm run start -w @ordofi/gateway",
    "auction": "npm run start -w @ordofi/auction",
    "searcher-bot": "npm run start -w @ordofi/searcher-bot",
    "arb-bot": "npm run start -w @ordofi/arb-bot",
    "web": "npm run dev -w @ordofi/web",
    "fork-proxy": "node scripts/fork-proxy.mjs",
    "node-check": "node scripts/node-check.mjs",
    "leakage": "node --import tsx scripts/leakage-report.mjs",
    "leakage-venues": "node --import tsx scripts/leakage-venues.mjs",
    "reset-index": "node --import tsx scripts/reset-index.mjs",
    "hints": "node --import tsx apps/auction/test-hints.mjs",
    "typecheck": "tsc -p apps/watcher/tsconfig.json && tsc -p apps/gateway/tsconfig.json && tsc -p apps/auction/tsconfig.json && tsc -p apps/searcher-bot/tsconfig.json && tsc -p apps/arb-bot/tsconfig.json",
    "test": "node --import tsx --test apps/gateway/test/*.test.ts apps/auction/test/*.test.ts apps/watcher/test/*.test.ts apps/arb-bot/test/*.test.ts packages/store/test/*.test.ts packages/core/test/*.test.ts",
    "build:stealth": "esbuild apps/web/vendor/stealth-entry.js --bundle --format=esm --minify --target=es2022 --outfile=apps/web/public/vendor/stealth.js --legal-comments=none",
    "prove-stealth": "node --import tsx scripts/prove-stealth.mjs"
  },
  "dependencies": {
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
