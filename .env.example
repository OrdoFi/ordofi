# --- Chain ---
ORDO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORDO_FEED_URL=wss://feed.mainnet.chain.robinhood.com

# Recommended for production: a dedicated RPC endpoint or your own Nitro node.
# The public endpoint rate-limits sustained load (HTTP 429).

# --- Pricing (report) ---
ORDO_ETH_USD=2250

# --- Gateway (:8547) ---
ORDO_PORT=8547
# Comma-separated key records: key:label:rateLimitPerMin:rebateAddress
# Leave empty in dev to auto-mint an ephemeral key.
ORDO_API_KEYS=
# Allow unauthenticated read-only calls (eth_call, eth_blockNumber, ...).
ORDO_ALLOW_ANON=1

# --- Auction (:8548) ---
ORDO_AUCTION_PORT=8548
ORDO_AUCTION_WINDOW_MS=200
ORDO_REBATE_USER=0.9
ORDO_REBATE_APP=0.05
ORDO_REBATE_PROTOCOL=0.05
# Deployed OrdoSettlement contract address (enables on-chain settlement records).
ORDO_SETTLEMENT_ADDRESS=

# --- Settlement contract deploy (contracts/) ---
# DEPLOYER_KEY=0x...
# AUCTIONEER=0x...   # address authorized to submit settlements (OrdoFi backend)
# TREASURY=0x...     # protocol fee recipient

# --- Web (:3000) ---
ORDO_WEB_PORT=3000
