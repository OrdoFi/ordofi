# --- Chain ---
ORDO_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ORDO_FEED_URL=wss://feed.mainnet.chain.robinhood.com

# Recommended for production: a dedicated RPC endpoint or your own Nitro node.
# The public endpoint rate-limits sustained load (HTTP 429).

# --- Pricing (report) ---
ORDO_ETH_USD=2250

# --- Gateway (:8547) ---
ORDO_PORT=8547
# Comma-separated key records: key:label:rateLimitPerMin:rebateAddress:mode
# The last two are optional. mode is `auction` (routed through the order-flow
# auction, so the key earns rebates) or `direct` (revert-protected straight
# send, no rebate); a key with a rebate address defaults to auction.
# Leave empty in dev to auto-mint an ephemeral key.
ORDO_API_KEYS=
# Allow unauthenticated read-only calls (eth_call, eth_blockNumber, ...).
ORDO_ALLOW_ANON=1
# Where the gateway and the explorer reach the auction. The localhost default
# only holds when everything runs on one machine; in containers or across
# hosts this must be set, or auction-mode keys quietly fall back to direct
# sends and earn nothing.
ORDO_AUCTION_URL=http://localhost:8548

# Deployed OrdoBundler factory. Set it and the gateway can offer genuinely
# atomic single-sender bundles and answer ordo_bundlerInfo; leave it empty and
# multi-transaction bundles stay best-effort, which the API says out loud.
ORDO_BUNDLER_ADDRESS=

# --- Auction (:8548) ---
ORDO_AUCTION_PORT=8548
# How long a user transaction is held while searchers bid. This is a real delay
# on the user's own trade, reported back as `auctionDelayMs`.
ORDO_AUCTION_WINDOW_MS=200
# How much of a user's transaction searchers get to see:
#   minimal  target and selector only, no pools
#   pools    + the pools it moves and which way (default; prices a backrun)
#   full     + the amounts (also enables front-running, so opt in deliberately)
ORDO_HINT_LEVEL=pools
ORDO_REBATE_USER=0.9
ORDO_REBATE_APP=0.05
ORDO_REBATE_PROTOCOL=0.05
# Deployed OrdoSettlement contract address.
# Setting this turns ON bond gating (bids must be covered by on-chain collateral).
ORDO_SETTLEMENT_ADDRESS=
# Auctioneer key that submits settle() on-chain. With ORDO_SETTLEMENT_ADDRESS set,
# this turns ON automatic on-chain settlement of winning bids.
ORDO_AUCTIONEER_KEY=
# How long searcher bond balances are cached before re-reading from chain.
ORDO_BOND_CACHE_MS=15000

# --- Settlement contract deploy (contracts/) ---
# DEPLOYER_KEY=0x...
# AUCTIONEER=0x...   # address authorized to submit settlements (OrdoFi backend)
# TREASURY=0x...     # protocol fee recipient

# --- Web (:3000) ---
ORDO_WEB_PORT=3000
